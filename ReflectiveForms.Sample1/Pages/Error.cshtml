@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 60vh;">
    <div class="text-center px-3" style="max-width: 480px;">
        <div class="mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="none" viewBox="0 0 24 24"
                 stroke="#ef4444" stroke-width="1.5" class="mx-auto">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
            </svg>
        </div>
        <h1 class="h3 fw-bold text-danger mb-2">Something went wrong</h1>
        <p class="text-muted mb-4">An error occurred while processing your request. Please try again or contact support if the problem persists.</p>

        @if (Model.ShowRequestId)
        {
            <div class="bg-light rounded-3 p-3 mb-4 d-inline-block">
                <small class="text-muted">Request ID</small><br />
                <code class="text-dark">@Model.RequestId</code>
            </div>
        }

        <div>
            <a href="/" class="btn btn-primary px-4">Go to Home</a>
        </div>
    </div>
</div>
