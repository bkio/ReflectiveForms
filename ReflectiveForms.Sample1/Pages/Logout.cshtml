@page
@model ReflectiveForms.Sample1.Pages.LogoutModel
@{
    ViewData["Title"] = "Signing out";
    Layout = "_Layout";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 60vh;">
    <div class="text-center px-3" style="max-width: 400px;">
        <div class="spinner-border text-primary mb-4" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
        <h2 class="h4 fw-bold mb-2">Signing you out</h2>
        <p class="text-muted">Please wait while we end your session securely.</p>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    localStorage.removeItem('authToken');
    sessionStorage.removeItem('authToken');

    fetch('/rf/api/logout', {
        method: 'POST',
        credentials: 'include'
    }).finally(() => {
        setTimeout(() => { window.location.href = '/'; }, 1200);
    });
});
</script>
}
