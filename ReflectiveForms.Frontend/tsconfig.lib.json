{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "./dist",
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "./dist"
  },
  "include": ["src/vite-env.d.ts", "src/lib/**/*", "src/components/**/*", "src/hooks/**/*", "src/pages/**/*", "src/types/**/*", "src/api/**/*"],
  "exclude": ["src/test/**/*", "src/main.tsx"]
}
