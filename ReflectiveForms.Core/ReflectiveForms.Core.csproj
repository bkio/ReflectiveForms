<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>ReflectiveForms.Core</Title>
    <Version>0.1.0</Version>
    <Authors>Burak Kara</Authors>
    <Description>Code-first admin panel and CRUD framework for .NET — define entity models with attributes, get a full admin UI with zero frontend code.</Description>
    <Copyright>Copyright (c) 2022- Burak Kara - AGPL-3.0-only</Copyright>
    <PackageProjectUrl>https://github.com/bkio/ReflectiveForms</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bkio/ReflectiveForms</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- optional: suppress "missing XML comment" warnings -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="AngleSharp" Version="1.3.0" />
    <PackageReference Include="CrossCloudKit.Interfaces" Version="2026.4.22.71" />
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.2" />
    <PackageReference Include="Jint" Version="4.4.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.20" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.14.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReflectiveForms.Core.Tests" />
    <InternalsVisibleTo Include="ReflectiveForms.Sample1.Tests" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="$(OutputPath)\$(AssemblyName).xml" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
